{
  "name": "legal-contract-audit",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && electron . --inspect=5858\"",
    "electron:build": "npm run build && electron-builder",
    "electron:package:win": "npm run build && electron-builder --win",
    "electron:package:mac": "npm run build && electron-builder --mac",
    "electron:package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "electron-serve": "^1.3.0",
    "lru-cache": "^11.2.4",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.11.0",
    "next": "15.0.7",
    "openai": "^4.67.3",
    "pdf-parse": "^1.1.1",
    "postcss": "^8.4.47",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^2.0.0",
    "wait-on": "^7.2.0"
  }
}
