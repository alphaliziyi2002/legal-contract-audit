# 腾讯云生产环境配置示例
# 复制此文件为 .env.production 并填写实际值

# ========================
# AI 服务配置
# ========================

# AI提供商 (deepseek 或 openai)
AI_PROVIDER=deepseek

# AI API密钥 (重要：在生产环境中保密)
AI_API_KEY=sk-your-actual-api-key-here

# AI API基础URL
AI_API_BASE_URL=https://api.deepseek.com/v1

# ========================
# 应用配置
# ========================

# 应用名称
NEXT_PUBLIC_APP_NAME=AI合约风险审计系统

# 应用版本
NEXT_PUBLIC_APP_VERSION=1.0.0

# ========================
# 性能和安全配置
# ========================

# 启用性能监控
ENABLE_PERFORMANCE_MONITOR=true

# 文件上传大小限制 (字节)
NEXT_PUBLIC_MAX_FILE_SIZE=10485760  # 10MB

# ========================
# 数据库配置
# ========================

# 数据库文件路径
DATABASE_PATH=/app/data/legal-library.db

# ========================
# 服务器配置
# ========================

# 服务器端口
PORT=3000

# 服务器主机
HOSTNAME=0.0.0.0

# ========================
# 功能开关
# ========================

# 启用法律文库
LEGAL_LIBRARY_ENABLED=true

# 启用文件上传
ENABLE_FILE_UPLOAD=true

# ========================
# 腾讯云特定配置
# ========================

# 腾讯云COS存储配置（可选）
# TENCENT_COS_SECRET_ID=your-cos-secret-id
# TENCENT_COS_SECRET_KEY=your-cos-secret-key
# TENCENT_COS_REGION=ap-guangzhou
# TENCENT_COS_BUCKET=your-bucket-name

# 腾讯云CLS日志服务（可选）
# TENCENT_CLS_SECRET_ID=your-cls-secret-id
# TENCENT_CLS_SECRET_KEY=your-cls-secret-key
# TENCENT_CLS_REGION=ap-guangzhou
# TENCENT_CLS_TOPIC_ID=your-topic-id